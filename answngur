<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>TOUCHLINE | Player Performance</title>

  <style>
    :root {
      --bg: #0c1118;
      --panel: #151e29;
      --line: #2b3848;
      --text: #eef3f8;
      --muted: #b1bfce;
      --accent: #c9f36b;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font: 15px system-ui, "Apple SD Gothic Neo", sans-serif;
    }

    button,
    input,
    select,
    textarea {
      font: inherit;
    }

    button {
      cursor: pointer;
      background: var(--accent);
      border: 0;
      border-radius: 7px;
      padding: 11px 16px;
      color: #15200b;
      font-weight: 700;
    }

    button.secondary {
      background: #263445;
      color: var(--text);
    }

    button.danger {
      background: #472a33;
      color: #ffd8df;
    }

    button:focus-visible,
    a:focus-visible {
      outline: 3px solid #fff;
      outline-offset: 3px;
    }

    aside {
      position: fixed;
      inset: 0 auto 0 0;
      width: 238px;
      background: #101721;
      border-right: 1px solid var(--line);
      padding: 30px 20px;
      display: flex;
      flex-direction: column;
    }

    .brand {
      font-size: 23px;
      font-weight: 900;
      letter-spacing: -1px;
    }

    .brand span {
      color: var(--accent);
    }

    .eyebrow {
      color: var(--accent);
      font-size: 11px;
      letter-spacing: 2px;
      font-weight: 700;
    }

    .sub {
      color: var(--muted);
      line-height: 1.7;
    }

    .brand + .sub {
      font-size: 11px;
    }

    nav {
      display: grid;
      gap: 7px;
      margin-top: 40px;
    }

    nav button {
      text-align: left;
      background: transparent;
      color: var(--muted);
      padding: 13px;
    }

    nav button.active {
      background: #233126;
      color: var(--accent);
    }

    .asidefoot {
      margin-top: auto;
      font-size: 11px;
      color: var(--muted);
    }

    main {
      margin-left: 238px;
      padding: 28px 40px;
      max-width: 1600px;
    }

    header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--line);
      padding-bottom: 22px;
      gap: 12px;
    }

    .actions {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    h1 {
      font-size: clamp(26px, 4vw, 42px);
      margin: 12px 0;
      letter-spacing: -1.4px;
    }

    h2 {
      font-size: 19px;
      margin: 0 0 18px;
    }

    h3 {
      margin: 0 0 12px;
      font-size: 16px;
    }

    .hero {
      padding: 34px 0 24px;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
    }

    .stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 14px;
      margin-bottom: 22px;
    }

    .card {
      background: var(--panel);
      border: 1px solid var(--line);
      border-radius: 13px;
      padding: 23px;
      min-width: 0;
    }

    .num {
      font-size: 34px;
      font-weight: 800;
      letter-spacing: -1px;
      margin: 14px 0 6px;
    }

    .tag {
      display: inline-block;
      padding: 5px 8px;
      border-radius: 5px;
      background: #263927;
      color: var(--accent);
      font-size: 11px;
    }

    .field {
      display: grid;
      gap: 7px;
      margin-bottom: 16px;
      color: var(--muted);
      font-size: 13px;
    }

    input,
    select,
    textarea {
      width: 100%;
      background: #0f1721;
      color: var(--text);
      border: 1px solid #405167;
      border-radius: 7px;
      padding: 11px;
      min-width: 0;
    }

    textarea {
      min-height: 80px;
    }

    .row {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
      padding: 15px 0;
      border-bottom: 1px solid var(--line);
    }

    .row:last-child {
      border: 0;
    }

    .row .actions {
      flex-shrink: 0;
    }

    .tiny {
      font-size: 12px;
      color: var(--muted);
    }

    .empty {
      padding: 22px 0;
      color: var(--muted);
      line-height: 1.7;
    }

    video {
      width: 100%;
      max-height: 460px;
      background: #080c11;
      border-radius: 8px;
    }

    .reaction {
      width: 100%;
      min-height: 150px;
      background: #263445;
      color: white;
      font-size: 22px;
      margin: 15px 0;
    }

    .reaction.ready {
      background: var(--accent);
      color: #13220b;
    }

    .notice {
      border-left: 3px solid var(--accent);
      padding: 12px 16px;
      background: #19251f;
      color: #d8e7d4;
      font-size: 13px;
      line-height: 1.7;
      margin: 16px 0;
    }

    footer {
      margin-top: 35px;
      padding: 18px 0;
      color: var(--muted);
      font-size: 12px;
      border-top: 1px solid var(--line);
    }

    
